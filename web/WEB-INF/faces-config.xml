<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_1.xsd"
              version="4.1">
    <!-- Los beans se registran mediante CDI (@Named), no mediante managed-bean.
         Listado y formulario utilizan navegacion implicita con outcomes y faces-redirect.
         No se requieren navigation-rule explicitas para estos destinos. -->
    <application>
        <locale-config>
            <default-locale>es</default-locale>
        </locale-config>
    </application>
</faces-config>
